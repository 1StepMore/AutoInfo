{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autoinfo.ai/schemas/knowledge-base-export-v1",
  "title": "AutoInfo Knowledge Base Export (agent-native JSON-LD)",
  "description": "Agent-native JSON-LD payload emitted by export_kb with format=\"agent\" (renderer: _export_agent_json in src/autoinfo/output/__init__.py). @type: KnowledgeBaseExport. The schema is a LOCAL file under docs/schemas/ — the @context/@type identifiers are stable contract strings, not hosting URLs.",
  "type": "object",
  "required": ["@context", "@type", "uuid", "domain", "entries", "schema_summary", "stats", "success"],
  "properties": {
    "@context": {
      "const": "https://autoinfo.ai/schemas/knowledge-base-export-v1",
      "description": "Stable identifier for this payload kind. Must equal _JSONLD_BASE_EXPORT[\"@context\"]."
    },
    "@type": {
      "const": "KnowledgeBaseExport",
      "description": "Must equal _JSONLD_BASE_EXPORT[\"@type\"]."
    },
    "uuid": { "type": "string", "description": "Per-export identifier (uuid4)." },
    "domain": { "type": "string", "description": "Human-readable domain label." },
    "entries": {
      "type": "array",
      "description": "KB entries included in the export (capped at 200).",
      "items": { "$ref": "#/definitions/exportEntry" }
    },
    "schema_summary": {
      "type": "object",
      "required": ["fields", "entry_schema_version"],
      "properties": {
        "fields": {
          "type": "array",
          "description": "Ordered field names of each entry object.",
          "items": { "type": "string" }
        },
        "entry_schema_version": { "type": "string", "description": "Currently the literal '1.0'." }
      },
      "additionalProperties": true
    },
    "stats": {
      "type": "object",
      "required": ["total_entries", "exported_entries", "domain", "generated_at"],
      "properties": {
        "total_entries": { "type": "integer", "minimum": 0, "description": "Total entries in the source KB." },
        "exported_entries": { "type": "integer", "minimum": 0, "description": "Entries actually exported (<= 200)." },
        "domain": { "type": "string", "description": "Domain filter; '*' when no domain was given." },
        "generated_at": { "type": "string", "description": "ISO-8601 UTC timestamp of export generation." }
      },
      "additionalProperties": true
    },
    "success": { "const": true, "description": "Always true for a successfully rendered export." }
  },
  "additionalProperties": true,
  "definitions": {
    "exportEntry": {
      "type": "object",
      "required": ["entry_id", "title", "summary", "source_url", "source_platform", "tier", "tags", "relevance_score", "collected_at"],
      "properties": {
        "entry_id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "source_url": { "type": "string" },
        "source_platform": { "type": "string" },
        "tier": { "type": "string", "description": "KB tier (Raw/Draft/Wiki); empty string when unset." },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "relevance_score": { "type": ["number", "null"], "description": "May be null." },
        "collected_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
