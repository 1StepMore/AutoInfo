{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autoinfo.ai/schemas/knowledge-tutorial-v1",
  "title": "AutoInfo Knowledge Tutorial (agent-native JSON-LD)",
  "description": "Agent-native JSON-LD payload emitted by generate_tutorial with format=\"agent\" (renderer: _render_tutorial_agent_json in src/autoinfo/output/__init__.py). @type: KnowledgeTutorial. The schema is a LOCAL file under docs/schemas/ — the @context/@type identifiers are stable contract strings, not hosting URLs.",
  "type": "object",
  "required": ["@context", "@type", "uuid", "title", "domain", "target_audience", "duration", "prerequisites", "objectives", "steps", "exercises", "summary", "further_reading", "source_entries", "generated_at", "metadata"],
  "properties": {
    "@context": {
      "const": "https://autoinfo.ai/schemas/knowledge-tutorial-v1",
      "description": "Stable identifier for this payload kind. Must equal _JSONLD_TUTORIAL[\"@context\"]."
    },
    "@type": {
      "const": "KnowledgeTutorial",
      "description": "Must equal _JSONLD_TUTORIAL[\"@type\"]."
    },
    "uuid": { "type": "string", "description": "Per-render tutorial identifier (uuid4)." },
    "title": { "type": "string", "description": "LLM title; falls back to '<domain> — Tutorial'." },
    "domain": { "type": "string" },
    "target_audience": { "type": "string" },
    "duration": { "type": "string", "description": "LLM duration; falls back to 'TBD'." },
    "prerequisites": { "type": "string", "description": "Free-form prerequisites; empty string when absent." },
    "objectives": {
      "type": "array",
      "description": "LLM learning objectives.",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "description": "Tutorial steps built from llm_result.content sections (1-indexed).",
      "items": { "$ref": "#/definitions/step" }
    },
    "exercises": {
      "type": "array",
      "description": "LLM practice exercises.",
      "items": { "$ref": "#/definitions/exercise" }
    },
    "summary": { "type": "string" },
    "further_reading": {
      "type": "array",
      "description": "LLM-suggested further reading links/titles.",
      "items": { "type": "string" }
    },
    "source_entries": {
      "type": "array",
      "description": "Up to 50 KB entries the tutorial is derived from.",
      "items": { "$ref": "#/definitions/sourceEntry" }
    },
    "generated_at": { "type": "string", "description": "ISO-8601 timestamp of generation." },
    "metadata": {
      "type": "object",
      "required": ["entry_count", "step_count", "exercise_count"],
      "properties": {
        "entry_count": { "type": "integer", "minimum": 0 },
        "step_count": { "type": "integer", "minimum": 0 },
        "exercise_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "step": {
      "type": "object",
      "required": ["step", "heading", "body"],
      "properties": {
        "step": { "type": "integer", "minimum": 1, "description": "1-indexed position of the section." },
        "heading": { "type": "string" },
        "body": { "type": "string" },
        "code_example": { "type": ["string", "null"], "description": "Optional code block; null when the section has none." },
        "code_language": { "type": ["string", "null"] },
        "key_takeaway": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "exercise": {
      "type": "object",
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "hint": { "type": ["string", "null"] },
        "solution": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "sourceEntry": {
      "type": "object",
      "required": ["entry_id", "title", "source_url", "source_platform"],
      "properties": {
        "entry_id": { "type": "string" },
        "title": { "type": "string" },
        "source_url": { "type": "string" },
        "source_platform": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
